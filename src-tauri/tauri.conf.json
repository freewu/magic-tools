{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MagicTools",
  "version": "2.1.1",
  "identifier": "vip.bluefrog.magictools",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://localhost:1212",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Magic Tools",
        "width": 1096,
        "height": 728,
        "minWidth": 1096,
        "minHeight": 728,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Developer Tools Application",
    "longDescription": "MagicTools - Developer Tools Application built with React and Tauri.",
    "publisher": "bluefrog",
    "copyright": "Copyright (c) 2026 bluefrog",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {}
}
