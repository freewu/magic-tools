{
  "name": "magic-tools",
  "version": "2.3.0",
  "description": "Developer Tools Application",
  "keywords": [
    "Developer Tools"
  ],
  "homepage": "https://freewu.github.io/magic-tools",
  "bugs": {
    "url": "https://github.com/freewu/magic-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freewu/magic-tools.git"
  },
  "license": "MIT",
  "author": {
    "name": "bluefrog",
    "email": "bluefrog.wu@gmail.com",
    "url": "https://freewu.github.io"
  },
  "contributors": [],
  "scripts": {
    "tauri": "tauri",
    "dev": "just dev",
    "dev:renderer": "vite",
    "build": "just build",
    "build:renderer": "vite build",
    "bundle": "just bundle",
    "publish": "just publish",
    "lint": "cross-env NODE_ENV=development eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "jest",
    "clean:renderer": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "clean": "just clean"
  },
  "browserslist": [],
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ]
  },
  "jest": {
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/.erb/mocks/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy"
    },
    "setupFiles": [
      "./.erb/scripts/jest-setup.ts"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "testPathIgnorePatterns": [
      "dist",
      ".erb/dll"
    ],
    "transform": {
      "\\.(ts|tsx|js|jsx)$": "ts-jest"
    }
  },
  "dependencies": {
    "@ant-design/icons": "^5.1.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "antd": "^5.5.0",
    "base-x": "^4.0.0",
    "bcryptjs": "^3.0.2",
    "color-convert": "^2.0.1",
    "crypto-js": "^4.1.1",
    "deepmerge": "^4.3.1",
    "highlight.js": "^11.8.0",
    "js-base64": "^3.7.5",
    "js-ini": "^1.6.0",
    "jsbarcode": "^3.12.3",
    "pinyin-pro": "^3.15.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1",
    "sql-formatter": "^12.2.1",
    "toml-patch": "^0.2.3",
    "yaml": "^2.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@types/color-convert": "^2.0.0",
    "@types/crypto-js": "^4.1.1",
    "@types/jest": "^29.4.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "18.13.0",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.51.0",
    "@typescript-eslint/parser": "^5.51.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "eslint": "^8.33.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-erb": "^4.0.6",
    "eslint-import-resolver-typescript": "^3.5.3",
    "eslint-plugin-compat": "^4.1.1",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jest": "^27.2.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.4.2",
    "jest-environment-jsdom": "^29.4.2",
    "prettier": "^2.8.4",
    "react-test-renderer": "^18.2.0",
    "ts-jest": "^29.0.5",
    "typescript": "^4.9.5",
    "vite": "^5.4.0"
  }
}
